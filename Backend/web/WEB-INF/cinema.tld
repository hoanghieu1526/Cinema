<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <description>Hàm định dạng dùng trong giao diện Cineverse (tiền tố f)</description>
    <tlib-version>1.0</tlib-version>
    <short-name>f</short-name>
    <uri>https://cineverse.local/functions</uri>

    <function>
        <description>80000 -> "80.000 đ"</description>
        <name>money</name>
        <function-class>util.Fmt</function-class>
        <function-signature>java.lang.String money(java.lang.Object)</function-signature>
    </function>
    <function>
        <description>"20:30 05/11/2026"</description>
        <name>datetime</name>
        <function-class>util.Fmt</function-class>
        <function-signature>java.lang.String datetime(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <description>"05/11/2026"</description>
        <name>date</name>
        <function-class>util.Fmt</function-class>
        <function-signature>java.lang.String date(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <description>"20:30"</description>
        <name>time</name>
        <function-class>util.Fmt</function-class>
        <function-signature>java.lang.String time(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <description>"Thứ năm, 05/11/2026"</description>
        <name>day</name>
        <function-class>util.Fmt</function-class>
        <function-signature>java.lang.String day(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <description>Màu nền (0-359) của poster giả, cố định theo mã phim</description>
        <name>hue</name>
        <function-class>util.Fmt</function-class>
        <function-signature>int hue(int)</function-signature>
    </function>
</taglib>
